---
import "../styles/global.css"

import { Button } from "@/components/ui/button"
import { Label } from "@/components/ui/label"
import { Textarea } from "@/components/ui/textarea"
import {
	ArrowDown,
	ArrowLeft,
	ArrowRight,
	ChevronsDown,
	HeartHandshake,
	Pause,
	Play,
	RotateCw,
	Send,
	Settings,
	ShieldCheck,
	UserRoundPlus,
	X,
} from "@lucide/astro"
---

<html lang="pt-BR">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/pwa-icon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="theme-color" content="#67d8f5" />
		<meta name="description" content="Um jogo simples de encaixar blocos coloridos." />
		<meta name="generator" content={Astro.generator} />
		<title>Jardim de Blocos</title>
	</head>
	<body class="game-bg min-h-svh overflow-x-hidden text-foreground antialiased">

		<div class="game-wrapper mx-auto flex min-h-svh w-full flex-col gap-3 px-3 py-3 sm:px-4">

			<header class="game-header flex items-center justify-between gap-4">
				<div class="min-w-0">
					<h1 class="truncate text-base font-black tracking-tight sm:text-xl">Jardim de Blocos</h1>
				</div>
				<div class="header-actions">
					<Button id="startButton" type="button" size="icon-sm" class="header-icon-btn bg-[#7a85ff] text-white" aria-label="Iniciar">
						<Play class="size-4" />
					</Button>
					<Button id="pauseButton" type="button" size="icon-sm" variant="outline" class="header-icon-btn bg-[#fb7562] text-white" aria-label="Pausar">
						<Pause class="size-4" />
					</Button>
					<Button id="settingsButton" type="button" size="icon-sm" variant="ghost" class="header-icon-btn bg-[#fff6d7] text-[#22655f]" aria-label="Configurações">
						<Settings class="size-4" />
					</Button>
				</div>
			</header>

			<div class="game-layout" aria-label="Jardim de Blocos">
				<div class="board-frame">
					<canvas id="gameCanvas" width="240" height="480" class="board-canvas block aspect-[1/2] rounded-lg sm:rounded-xl" aria-label="Tabuleiro do jogo"></canvas>
					<div class="game-overlay show" id="gameOverlay">
						<strong class="text-lg font-bold sm:text-xl">Jardim de Blocos</strong>
						<span class="text-xs text-muted-foreground sm:text-sm">Toque em iniciar</span>
					</div>
				</div>

				<aside class="sidebar" aria-live="polite">
					<div class="sidebar-section">
						<span class="sidebar-label">Próxima</span>
						<canvas id="nextCanvas" width="96" height="96" class="next-canvas rounded-xl bg-background"></canvas>
					</div>

					<div class="sidebar-divider"></div>

					<div class="sidebar-section stats-grid">
						<div class="stat-item">
							<span class="stat-label">Pontos</span>
							<strong class="stat-value" data-stat="score">0</strong>
						</div>
						<div class="stat-item">
							<span class="stat-label">Linhas</span>
							<strong class="stat-value" data-stat="lines">0</strong>
						</div>
						<div class="stat-item">
							<span class="stat-label">Nível</span>
							<strong class="stat-value" data-stat="level">1</strong>
						</div>
						<div class="stat-item">
							<span class="stat-label">Recorde</span>
							<strong class="stat-value" id="highScore">0</strong>
						</div>
					</div>

					<p class="keyboard-hint">← → ↓ mover · ↑ girar · Espaço queda</p>
				</aside>
			</div>

			<div class="controls-bar">
				<div class="controls-pad">
					<button type="button" class="ctrl-btn" aria-label="Mover para esquerda" data-action="left">
						<ArrowLeft class="ctrl-icon" />
					</button>
					<button type="button" class="ctrl-btn ctrl-rotate" aria-label="Girar peça" data-action="rotate">
						<RotateCw class="ctrl-icon" />
					</button>
					<button type="button" class="ctrl-btn" aria-label="Mover para direita" data-action="right">
						<ArrowRight class="ctrl-icon" />
					</button>
					<button type="button" class="ctrl-btn" aria-label="Descer peça" data-action="down">
						<ArrowDown class="ctrl-icon" />
					</button>
					<button type="button" class="ctrl-btn ctrl-btn-accent" aria-label="Queda rápida" data-action="hardDrop">
						<ChevronsDown class="ctrl-icon" />
					</button>
				</div>
			</div>
		</div>

		<aside class="settings-panel fixed inset-0 z-40 grid place-items-end bg-black/50 p-3 opacity-0 backdrop-blur-sm transition-opacity sm:p-4" id="settingsPanel" aria-hidden="true">
			<section class="settings-card max-h-[calc(100svh-1.5rem)] w-full max-w-md translate-y-4 overflow-y-auto rounded-2xl border-2 border-border bg-card p-4 text-card-foreground shadow-2xl transition-transform sm:p-5" aria-labelledby="settingsTitle">
				<div class="mb-5 flex items-start justify-between gap-4">
					<div>
						<p class="text-sm font-semibold text-[#22655f]">Sua rede de apoio</p>
						<h2 id="settingsTitle" class="mt-1 text-xl font-bold">Pessoas de confiança</h2>
					</div>
					<Button id="closeSettingsButton" type="button" variant="ghost" size="sm" class="shrink-0 text-foreground hover:bg-accent hover:text-accent-foreground">
						<X class="size-4" /> Fechar
					</Button>
				</div>

				<div class="rounded-xl bg-[#e3f5ed] p-4 text-[#174b45]">
					<div class="flex gap-3">
						<ShieldCheck class="mt-0.5 size-5 shrink-0" aria-hidden="true" />
						<p class="text-sm leading-5">Os nomes e telefones ficam somente neste aparelho. Nesta etapa, nada será enviado por mensagem, e-mail ou outro serviço.</p>
					</div>
				</div>

				<form id="trustedContactForm" class="mt-5 grid gap-4">
					<p class="text-sm text-muted-foreground">Cadastre até 3 pessoas. Elas recebem o recado quando você pedir apoio.</p>
					<div class="grid gap-2">
						<Label for="contactName">Nome</Label>
						<input id="contactName" name="name" autocomplete="name" required maxlength="80" placeholder="Ex.: Ana Souza" class="h-10 rounded-md border-2 border-border bg-background px-3 text-sm outline-none transition focus:border-primary" />
					</div>
					<div class="grid gap-2">
						<Label for="contactRelationship">Relação <span class="font-normal text-muted-foreground">(opcional)</span></Label>
						<input id="contactRelationship" name="relationship" maxlength="50" placeholder="Ex.: irmã, amiga, vizinha" class="h-10 rounded-md border-2 border-border bg-background px-3 text-sm outline-none transition focus:border-primary" />
					</div>
					<div class="grid gap-2">
						<Label for="contactPhone">Telefone</Label>
						<input id="contactPhone" name="phone" type="tel" inputmode="tel" autocomplete="tel" required maxlength="30" placeholder="(00) 00000-0000" class="h-10 rounded-md border-2 border-border bg-background px-3 text-sm outline-none transition focus:border-primary" />
					</div>
					<Button id="addContactButton" type="submit" class="border-2 border-border bg-primary font-bold text-primary-foreground hover:bg-secondary hover:text-secondary-foreground">
						<UserRoundPlus class="size-4" /> Adicionar pessoa
					</Button>
				</form>
				<p id="contactLimitNotice" hidden class="mt-5 rounded-xl bg-[#fff6d7] px-4 py-3 text-sm leading-5 text-[#174b45]">Rede completa: 3 de 3 pessoas. Remova alguém se quiser cadastrar outra.</p>

				<div class="mt-6 border-t-2 border-border pt-5">
					<div class="flex items-baseline justify-between gap-4">
						<h3 class="font-bold">Pessoas configuradas</h3>
						<span id="contactCount" class="text-sm text-muted-foreground">0 de 3</span>
					</div>
					<ul id="trustedContactsList" class="mt-3 grid gap-2" aria-live="polite"></ul>
					<p id="emptyContacts" class="mt-3 rounded-xl bg-muted px-4 py-3 text-sm leading-5 text-muted-foreground">Adicione até 3 pessoas em quem você confia para deixar a sua rede de apoio pronta.</p>
				</div>

				<div class="mt-6 border-t-2 border-border pt-5">
					<div class="flex gap-3">
						<HeartHandshake class="mt-0.5 size-5 shrink-0 text-[#22655f]" aria-hidden="true" />
						<div>
							<h3 class="font-bold">Como você está?</h3>
							<p class="mt-1 text-sm leading-5 text-muted-foreground">Escreva um recado para a sua rede. O aparelho só vibra para confirmar o aviso — nada sai por SMS, ligação ou SOS do celular.</p>
						</div>
					</div>
					<form id="feedbackForm" class="mt-4 grid gap-3">
						<div class="grid gap-2">
							<Label for="feedbackMessage">Seu recado</Label>
							<Textarea id="feedbackMessage" name="message" rows={4} required maxlength="280" placeholder="Ex.: estou em casa e preciso de alguém por perto." class="min-h-24 rounded-md border-2 border-border bg-background" />
						</div>
						<p id="feedbackNeedsContacts" hidden class="rounded-xl bg-muted px-4 py-3 text-sm leading-5 text-muted-foreground">Cadastre pelo menos uma pessoa de confiança para enviar o recado.</p>
						<Button id="sendFeedbackButton" type="submit" class="border-2 border-border bg-primary font-bold text-primary-foreground hover:bg-secondary hover:text-secondary-foreground">
							<Send class="size-4" /> Avisar pessoas de confiança
						</Button>
					</form>
				</div>
			</section>
		</aside>

		<div class="toast fixed bottom-5 left-1/2 z-50 -translate-x-1/2 translate-y-4 rounded-full border-2 border-border bg-card px-5 py-2.5 text-sm font-bold text-card-foreground opacity-0 shadow-lg transition" id="toast" role="status" aria-live="polite"></div>

		<script>
			const canvas = document.querySelector<HTMLCanvasElement>('#gameCanvas')!;
			const ctx = canvas.getContext('2d')!;
			const nextCanvas = document.querySelector<HTMLCanvasElement>('#nextCanvas')!;
			const nextCtx = nextCanvas.getContext('2d')!;
			const highScoreEl = document.querySelector<HTMLElement>('#highScore')!;
			const overlay = document.querySelector<HTMLElement>('#gameOverlay')!;
			const startButton = document.querySelector<HTMLElement>('#startButton')!;
			const pauseButton = document.querySelector<HTMLElement>('#pauseButton')!;
			const settingsButton = document.querySelector<HTMLElement>('#settingsButton')!;
			const closeSettingsButton = document.querySelector<HTMLElement>('#closeSettingsButton')!;
			const settingsPanel = document.querySelector<HTMLElement>('#settingsPanel')!;
			const trustedContactForm = document.querySelector<HTMLFormElement>('#trustedContactForm')!;
			const trustedContactsList = document.querySelector<HTMLUListElement>('#trustedContactsList')!;
			const emptyContacts = document.querySelector<HTMLElement>('#emptyContacts')!;
			const contactCount = document.querySelector<HTMLElement>('#contactCount')!;
			const contactLimitNotice = document.querySelector<HTMLElement>('#contactLimitNotice')!;
			const feedbackForm = document.querySelector<HTMLFormElement>('#feedbackForm')!;
			const feedbackMessage = document.querySelector<HTMLTextAreaElement>('#feedbackMessage')!;
			const sendFeedbackButton = document.querySelector<HTMLButtonElement>('#sendFeedbackButton')!;
			const feedbackNeedsContacts = document.querySelector<HTMLElement>('#feedbackNeedsContacts')!;
			const toast = document.querySelector<HTMLElement>('#toast')!;
			const MAX_TRUSTED_CONTACTS = 3;

			const COLS = 10;
			const ROWS = 20;
			const BLOCK = 24;
			const BG = '#9f493d';

			const COLORS = [
				'#000000',
				'#62c7ff',
				'#8357f5',
				'#ff9f43',
				'#ffd85c',
				'#76e06f',
				'#ff6b8a',
				'#45d5c8',
			];

			const PIECES = [
				[[1, 1, 1, 1]],
				[[2, 0, 0], [2, 2, 2]],
				[[0, 0, 3], [3, 3, 3]],
				[[4, 4], [4, 4]],
				[[0, 5, 5], [5, 5, 0]],
				[[0, 6, 0], [6, 6, 6]],
				[[7, 7, 0], [0, 7, 7]],
			];

			type TrustedContact = { id: string; name: string; relationship: string; phone: string };
			let trustedContacts: TrustedContact[] = [];

			try {
				const storedContacts = localStorage.getItem('defesa-da-mulher-trusted-contacts');
				trustedContacts = storedContacts ? JSON.parse(storedContacts) : [];
				if (!Array.isArray(trustedContacts)) trustedContacts = [];
				trustedContacts = trustedContacts
					.filter((contact): contact is TrustedContact => Boolean(contact && contact.id && contact.name && contact.phone))
					.slice(0, MAX_TRUSTED_CONTACTS);
			} catch {}


			let arena = createArena();
			let player = { matrix: null as number[][] | null, x: 0, y: 0 };
			let nextPiece: number[][] | null = null;
			let score = 0;
			let linesCount = 0;
			let level = 1;
			let highScore = 0;
			let dropCounter = 0;
			let lastTime = 0;
			let running = false;
			let paused = false;
			try { highScore = parseInt(localStorage.getItem('blocos-high') || '0', 10); } catch {}
			highScoreEl.textContent = String(highScore);

			ctx.scale(BLOCK, BLOCK);
			nextCtx.scale(BLOCK, BLOCK);

			function createArena(): number[][] {
				return Array.from({ length: ROWS }, () => Array(COLS).fill(0));
			}

			function createPiece(): number[][] {
				return PIECES[Math.floor(Math.random() * PIECES.length)].map(r => [...r]);
			}

			function drawCell(c: CanvasRenderingContext2D, x: number, y: number, value: number) {
				c.fillStyle = COLORS[value];
				c.fillRect(x, y, 1, 1);

				c.fillStyle = 'rgba(255,255,255,0.28)';
				c.fillRect(x + 0.04, y + 0.04, 0.92, 0.06);
				c.fillRect(x + 0.04, y + 0.04, 0.06, 0.92);

				c.fillStyle = 'rgba(0,0,0,0.28)';
				c.fillRect(x + 0.04, y + 0.90, 0.92, 0.06);
				c.fillRect(x + 0.90, y + 0.04, 0.06, 0.92);

				c.fillStyle = 'rgba(255,255,255,0.06)';
				c.fillRect(x + 0.14, y + 0.14, 0.72, 0.32);
			}

			function drawMatrix(c: CanvasRenderingContext2D, matrix: number[][], offset: { x: number; y: number }) {
				matrix.forEach((row, y) => {
					row.forEach((value, x) => {
						if (value) drawCell(c, x + offset.x, y + offset.y, value);
					});
				});
			}

			function getGhostY(): number {
				if (!player.matrix) return player.y;
				let testY = player.y;
				while (true) {
					testY++;
					for (let y = 0; y < player.matrix.length; y++) {
						for (let x = 0; x < player.matrix[y].length; x++) {
							if (player.matrix[y][x]) {
								const bx = x + player.x;
								const by = y + testY;
								if (by >= ROWS || bx < 0 || bx >= COLS || (by >= 0 && arena[by][bx] !== 0)) {
									return testY - 1;
								}
							}
						}
					}
				}
			}

			function drawGhost() {
				if (!player.matrix) return;
				const ghostY = getGhostY();
				if (ghostY <= player.y) return;
				ctx.globalAlpha = 0.15;
				player.matrix.forEach((row, y) => {
					row.forEach((value, x) => {
						if (value) {
							ctx.fillStyle = COLORS[value];
							ctx.fillRect(x + player.x, y + ghostY, 1, 1);
							ctx.strokeStyle = 'rgba(255,255,255,0.1)';
							ctx.lineWidth = 0.04;
							ctx.strokeRect(x + player.x + 0.04, y + ghostY + 0.04, 0.92, 0.92);
						}
					});
				});
				ctx.globalAlpha = 1;
			}

			function drawNext() {
				nextCtx.fillStyle = BG;
				nextCtx.fillRect(0, 0, 4, 4);
				if (!nextPiece) return;
				const ox = (4 - nextPiece[0].length) / 2;
				const oy = (4 - nextPiece.length) / 2;
				drawMatrix(nextCtx, nextPiece, { x: ox, y: oy });
			}

			function draw() {
				ctx.fillStyle = BG;
				ctx.fillRect(0, 0, COLS, ROWS);

				ctx.strokeStyle = 'rgba(255,244,217,0.08)';
				ctx.lineWidth = 0.02;
				for (let x = 0; x <= COLS; x++) {
					ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, ROWS); ctx.stroke();
				}
				for (let y = 0; y <= ROWS; y++) {
					ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(COLS, y); ctx.stroke();
				}

				drawMatrix(ctx, arena, { x: 0, y: 0 });
				if (player.matrix && running && !paused) drawGhost();
				if (player.matrix) drawMatrix(ctx, player.matrix, player);
			}

			function collide(): boolean {
				if (!player.matrix) return false;
				for (let y = 0; y < player.matrix.length; y++) {
					for (let x = 0; x < player.matrix[y].length; x++) {
						if (player.matrix[y][x] && (arena[y + player.y]?.[x + player.x] !== 0)) return true;
					}
				}
				return false;
			}

			function merge() {
				player.matrix?.forEach((row, y) => {
					row.forEach((value, x) => {
						if (value) arena[y + player.y][x + player.x] = value;
					});
				});
			}

			function sweep() {
				let cleared = 0;
				outer: for (let y = arena.length - 1; y >= 0; y--) {
					for (let x = 0; x < arena[y].length; x++) {
						if (!arena[y][x]) continue outer;
					}
					arena.splice(y, 1);
					arena.unshift(Array(COLS).fill(0));
					cleared++;
					y++;
				}
				if (cleared) {
					linesCount += cleared;
					score += [0, 100, 300, 500, 800][cleared] * level;
					level = Math.floor(linesCount / 8) + 1;
					updateHud();
				}
			}

			function rotate(matrix: number[][]) {
				for (let y = 0; y < matrix.length; y++) {
					for (let x = 0; x < y; x++) {
						[matrix[x][y], matrix[y][x]] = [matrix[y][x], matrix[x][y]];
					}
				}
				matrix.forEach(r => r.reverse());
			}

			function playerRotate() {
				if (!running || paused || !player.matrix) return;
				const startX = player.x;
				let offset = 1;
				rotate(player.matrix);
				while (collide()) {
					player.x += offset;
					offset = -(offset + (offset > 0 ? 1 : -1));
					if (offset > player.matrix[0].length) {
						rotate(player.matrix); rotate(player.matrix); rotate(player.matrix);
						player.x = startX;
						return;
					}
				}
				draw();
			}

			function playerMove(dir: number) {
				if (!running || paused) return;
				player.x += dir;
				if (collide()) player.x -= dir;
				draw();
			}

			function playerDrop() {
				if (!running || paused) return;
				player.y++;
				if (collide()) {
					player.y--;
					merge();
					sweep();
					playerReset();
				}
				dropCounter = 0;
				draw();
			}

			function hardDrop() {
				if (!running || paused || !player.matrix) return;
				const ghostY = getGhostY();
				score += (ghostY - player.y) * 2;
				player.y = ghostY;
				merge();
				sweep();
				playerReset();
				dropCounter = 0;
				updateHud();
				draw();
			}

			function playerReset() {
				player.matrix = nextPiece || createPiece();
				nextPiece = createPiece();
				drawNext();
				player.y = 0;
				player.x = Math.floor((COLS - player.matrix[0].length) / 2);
				if (collide()) {
					running = false;
					const isNewRecord = score > highScore && score > 0;
					if (isNewRecord) {
						highScore = score;
						try { localStorage.setItem('blocos-high', String(highScore)); } catch {}
						highScoreEl.textContent = String(highScore);
					}
					overlay.classList.add('show');
					overlay.innerHTML = `
						<strong class="text-xl font-bold sm:text-2xl">Fim de jogo</strong>
						<span class="tabular-nums text-base text-muted-foreground">${score} pontos</span>
						${isNewRecord ? '<span class="text-xs font-semibold text-amber-400">Novo recorde!</span>' : ''}
						<span class="mt-1 text-xs text-muted-foreground">Toque em iniciar</span>
					`;
				}
			}

			function updateStat(name: string, value: number) {
				document.querySelectorAll<HTMLElement>(`[data-stat="${name}"]`).forEach(el => {
					el.textContent = String(value);
					el.classList.remove('bump');
					void el.offsetWidth;
					el.classList.add('bump');
				});
			}

			function updateHud() {
				updateStat('score', score);
				updateStat('lines', linesCount);
				updateStat('level', level);
			}

			function update(time = 0) {
				const delta = time - lastTime;
				lastTime = time;
				if (running && !paused) {
					dropCounter += delta;
					if (dropCounter > Math.max(100, 800 - level * 60)) playerDrop();
				}
				draw();
				requestAnimationFrame(update);
			}

			function setPauseLabel(label: string) {
				const icon = label === 'Continuar'
					? '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="6 3 20 12 6 21 6 3"/></svg>'
					: '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="14" y="4" width="4" height="16" rx="1"/><rect x="6" y="4" width="4" height="16" rx="1"/></svg>';
				pauseButton.innerHTML = `${icon} <span class="btn-label">${label}</span>`;
			}

			function startGame() {
				arena = createArena();
				score = 0;
				linesCount = 0;
				level = 1;
				dropCounter = 0;
				running = true;
				paused = false;
				nextPiece = null;
				setPauseLabel('Pausar');
				overlay.classList.remove('show');
				updateHud();
				playerReset();
				draw();
			}

			function togglePause() {
				if (!running) return;
				paused = !paused;
				setPauseLabel(paused ? 'Continuar' : 'Pausar');
				overlay.classList.toggle('show', paused);
				if (paused) overlay.innerHTML = '<strong class="text-lg font-bold">Pausado</strong><span class="text-xs text-muted-foreground">Toque em continuar</span>';
			}

			function showToast(msg: string) {
				toast.textContent = msg;
				toast.classList.add('show');
				setTimeout(() => toast.classList.remove('show'), 2600);
			}

			function setSettings(open: boolean) {
				settingsPanel.classList.toggle('open', open);
				settingsPanel.setAttribute('aria-hidden', String(!open));
			}

			function saveTrustedContacts() {
				try {
					localStorage.setItem('defesa-da-mulher-trusted-contacts', JSON.stringify(trustedContacts));
				} catch {
					showToast('Não foi possível salvar neste aparelho.');
				}
			}

			function updateSupportState() {
				const count = trustedContacts.length;
				const atLimit = count >= MAX_TRUSTED_CONTACTS;
				const hasContacts = count > 0;

				trustedContactForm.hidden = atLimit;
				contactLimitNotice.hidden = !atLimit;
				emptyContacts.hidden = hasContacts;
				contactCount.textContent = `${count} de ${MAX_TRUSTED_CONTACTS}`;

				sendFeedbackButton.disabled = !hasContacts;
				feedbackMessage.disabled = !hasContacts;
				feedbackNeedsContacts.hidden = hasContacts;
			}

			function vibrateNotify() {
				const pulses = trustedContacts.flatMap((_, index) => index === 0 ? [220] : [90, 220]);
				try {
					navigator.vibrate?.(pulses.length ? pulses : [220]);
				} catch {}
			}

			function renderTrustedContacts() {
				trustedContactsList.replaceChildren();
				updateSupportState();

				for (const contact of trustedContacts) {
					const item = document.createElement('li');
					item.className = 'flex items-center justify-between gap-3 rounded-xl border-2 border-border bg-background px-3 py-3';

					const details = document.createElement('div');
					details.className = 'min-w-0';
					const name = document.createElement('p');
					name.className = 'truncate font-bold';
					name.textContent = contact.name;
					const meta = document.createElement('p');
					meta.className = 'mt-0.5 truncate text-sm text-muted-foreground';
					meta.textContent = [contact.relationship, contact.phone].filter(Boolean).join(' · ');
					details.append(name, meta);

					const removeButton = document.createElement('button');
					removeButton.type = 'button';
					removeButton.className = 'inline-flex size-9 shrink-0 items-center justify-center rounded-md text-destructive transition hover:bg-destructive hover:text-destructive-foreground focus:outline-none focus:ring-2 focus:ring-ring';
					removeButton.setAttribute('aria-label', `Remover ${contact.name}`);
					removeButton.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/></svg>';
					removeButton.addEventListener('click', () => {
						trustedContacts = trustedContacts.filter(item => item.id !== contact.id);
						saveTrustedContacts();
						renderTrustedContacts();
						showToast('Pessoa removida da sua rede de apoio.');
					});

					item.append(details, removeButton);
					trustedContactsList.append(item);
				}
			}

			startButton.addEventListener('click', startGame);
			pauseButton.addEventListener('click', togglePause);

			document.querySelectorAll<HTMLElement>('[data-action]').forEach(btn => {
				btn.addEventListener('click', () => {
					const a = btn.dataset.action;
					if (a === 'left') playerMove(-1);
					if (a === 'right') playerMove(1);
					if (a === 'down') playerDrop();
					if (a === 'rotate') playerRotate();
					if (a === 'hardDrop') hardDrop();
				});
			});

			document.addEventListener('keydown', (e) => {
				if (e.key === 'Escape' && settingsPanel.classList.contains('open')) {
					setSettings(false);
					return;
				}

				const target = e.target;
				if (target instanceof HTMLElement && target.closest('input, textarea, [contenteditable="true"]')) return;

				if (['ArrowLeft', 'ArrowRight', 'ArrowDown', 'ArrowUp', ' '].includes(e.key)) e.preventDefault();
				if (e.key === 'ArrowLeft') playerMove(-1);
				if (e.key === 'ArrowRight') playerMove(1);
				if (e.key === 'ArrowDown') playerDrop();
				if (e.key === 'ArrowUp') playerRotate();
				if (e.key === ' ') hardDrop();
				if (e.key.toLowerCase() === 'p') togglePause();
			});

			settingsButton.addEventListener('click', () => setSettings(true));
			closeSettingsButton.addEventListener('click', () => setSettings(false));
			settingsPanel.addEventListener('click', (e) => { if (e.target === settingsPanel) setSettings(false); });

			trustedContactForm.addEventListener('submit', (e) => {
				e.preventDefault();
				if (trustedContacts.length >= MAX_TRUSTED_CONTACTS) {
					showToast('Você já cadastrou 3 pessoas de confiança.');
					updateSupportState();
					return;
				}

				const formData = new FormData(trustedContactForm);
				const name = String(formData.get('name') ?? '').trim();
				const relationship = String(formData.get('relationship') ?? '').trim();
				const phone = String(formData.get('phone') ?? '').trim();
				if (!name || !phone) return;

				trustedContacts.push({ id: crypto.randomUUID(), name, relationship, phone });
				saveTrustedContacts();
				renderTrustedContacts();
				trustedContactForm.reset();
				showToast(trustedContacts.length === MAX_TRUSTED_CONTACTS
					? 'Rede completa: 3 pessoas cadastradas.'
					: 'Pessoa adicionada à sua rede de apoio.');
			});

			feedbackForm.addEventListener('submit', (e) => {
				e.preventDefault();
				const message = feedbackMessage.value.trim();
				if (!message) return;
				if (trustedContacts.length === 0) {
					showToast('Cadastre pelo menos uma pessoa de confiança.');
					updateSupportState();
					return;
				}

				console.info('[support-feedback]', {
					message,
					timestamp: new Date().toISOString(),
					contacts: trustedContacts.map(({ name, relationship, phone }) => ({ name, relationship, phone })),
				});

				vibrateNotify();
				feedbackForm.reset();
				updateSupportState();
				setSettings(false);
			});

			renderTrustedContacts();
			draw();
			drawNext();
			requestAnimationFrame(update);
		</script>
	</body>
</html>

