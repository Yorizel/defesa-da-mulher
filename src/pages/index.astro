---
import "../styles/global.css"

import { Button } from "@/components/ui/button"
import {
	Dialog,
	DialogClose,
	DialogContent,
	DialogDescription,
	DialogFooter,
	DialogHeader,
	DialogTitle,
	DialogTrigger,
} from "@/components/ui/dialog"
import { Label } from "@/components/ui/label"
import { Textarea } from "@/components/ui/textarea"
import {
	ArrowDown,
	ArrowLeft,
	ArrowRight,
	ChevronsDown,
	Pause,
	Play,
	RotateCw,
	Send,
	Settings,
	X,
} from "@lucide/astro"
---

<html lang="pt-BR" class="dark">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/pwa-icon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="theme-color" content="#0a1f1a" />
		<meta name="description" content="Um jogo simples de encaixar blocos coloridos." />
		<meta name="generator" content={Astro.generator} />
		<title>Jardim de Blocos</title>
	</head>
	<body class="game-bg flex min-h-svh flex-col items-center overflow-x-hidden p-3 text-emerald-50 antialiased sm:p-4">

		<div class="game-wrapper my-auto inline-flex flex-col gap-2 sm:gap-2.5">

			<header class="flex items-center justify-between gap-4">
				<div class="min-w-0">
					<span class="text-[0.55rem] font-black uppercase tracking-[0.2em] text-emerald-400/40 sm:text-[0.65rem]">Jogo casual</span>
					<h1 class="truncate text-base font-bold tracking-tight sm:text-xl">Jardim de Blocos</h1>
				</div>
				<Button id="settingsButton" type="button" size="icon-sm" variant="ghost" class="shrink-0 rounded-full text-emerald-400/50 hover:bg-emerald-400/10 hover:text-emerald-300" aria-label="Configurações">
					<Settings class="size-4" />
				</Button>
			</header>

			<div class="game-layout" aria-label="Jardim de Blocos">
				<div class="board-frame">
					<canvas id="gameCanvas" width="240" height="480" class="board-canvas block aspect-[1/2] rounded-lg sm:rounded-xl" aria-label="Tabuleiro do jogo"></canvas>
					<div class="game-overlay show" id="gameOverlay">
						<strong class="text-lg font-bold sm:text-xl">Jardim de Blocos</strong>
						<span class="text-xs text-emerald-300/50 sm:text-sm">Toque em iniciar</span>
					</div>
				</div>

				<aside class="sidebar" aria-live="polite">
					<div class="sidebar-section">
						<span class="sidebar-label">Próxima</span>
						<canvas id="nextCanvas" width="96" height="96" class="next-canvas rounded-md bg-[#071f1a] sm:rounded-lg"></canvas>
					</div>

					<div class="sidebar-divider"></div>

					<div class="sidebar-section stats-grid">
						<div class="stat-item">
							<span class="stat-label">Pontos</span>
							<strong class="stat-value" data-stat="score">0</strong>
						</div>
						<div class="stat-item">
							<span class="stat-label">Linhas</span>
							<strong class="stat-value" data-stat="lines">0</strong>
						</div>
						<div class="stat-item">
							<span class="stat-label">Nível</span>
							<strong class="stat-value" data-stat="level">1</strong>
						</div>
						<div class="stat-item">
							<span class="stat-label">Recorde</span>
							<strong class="stat-value" id="highScore">0</strong>
						</div>
					</div>

					<div class="sidebar-divider"></div>

					<div class="sidebar-section sidebar-actions">
						<Button id="startButton" type="button" class="sidebar-btn h-8 w-full bg-emerald-500 text-xs font-bold text-emerald-950 hover:bg-emerald-400 sm:h-9 sm:text-sm">
							<Play class="size-3.5 sm:size-4" /> <span class="btn-label">Iniciar</span>
						</Button>
						<Button id="pauseButton" type="button" variant="outline" class="sidebar-btn h-8 w-full border-emerald-500/20 text-xs text-emerald-300 hover:bg-emerald-500/10 hover:text-emerald-200 sm:h-9 sm:text-sm">
							<Pause class="size-3.5 sm:size-4" /> <span class="btn-label">Pausar</span>
						</Button>
					</div>

					<p class="keyboard-hint">← → ↓ mover · ↑ girar<br/>Espaço queda · P pausa</p>
				</aside>
			</div>

			<div class="controls-bar">
				<div class="grid grid-cols-5 gap-1 sm:gap-1.5">
					<button type="button" class="ctrl-btn" aria-label="Mover para esquerda" data-action="left">
						<ArrowLeft class="ctrl-icon" />
					</button>
					<button type="button" class="ctrl-btn" aria-label="Girar peça" data-action="rotate">
						<RotateCw class="ctrl-icon" />
					</button>
					<button type="button" class="ctrl-btn" aria-label="Mover para direita" data-action="right">
						<ArrowRight class="ctrl-icon" />
					</button>
					<button type="button" class="ctrl-btn" aria-label="Descer peça" data-action="down">
						<ArrowDown class="ctrl-icon" />
					</button>
					<button type="button" class="ctrl-btn ctrl-btn-accent" aria-label="Queda rápida" data-action="hardDrop">
						<ChevronsDown class="ctrl-icon" />
					</button>
				</div>
			</div>
		</div>

		<aside class="settings-panel fixed inset-0 z-40 grid place-items-end bg-black/50 p-3 opacity-0 backdrop-blur-sm transition-opacity sm:p-4" id="settingsPanel" aria-hidden="true">
			<div class="settings-card w-full max-w-md translate-y-4 rounded-2xl border border-emerald-500/12 bg-[#0a1f1a]/95 p-4 shadow-2xl backdrop-blur transition-transform sm:p-5">
				<div class="mb-4 flex items-center justify-between">
					<h2 class="text-lg font-bold">Configurações</h2>
					<Button id="closeSettingsButton" type="button" variant="ghost" size="sm" class="text-emerald-400 hover:bg-emerald-500/10 hover:text-emerald-300">
						<X class="size-4" /> Fechar
					</Button>
				</div>
				<Dialog>
					<DialogTrigger id="reportButton" type="button" class="w-full bg-emerald-500 font-bold text-emerald-950 hover:bg-emerald-400">Reportar problema</DialogTrigger>
					<DialogContent>
						<form id="reportForm" class="grid gap-4">
							<DialogHeader>
								<DialogTitle>Reportar problema</DialogTitle>
								<DialogDescription>Descreva o que aconteceu para ajudar a melhorar.</DialogDescription>
							</DialogHeader>
							<div class="grid gap-2">
								<Label for="reportMessage">Mensagem</Label>
								<Textarea id="reportMessage" name="message" rows={4} placeholder="Ex.: a peça travou na tela" required />
								<p class="text-xs text-muted-foreground">Ao enviar, o navegador pode pedir permissão de localização.</p>
							</div>
							<DialogFooter>
								<DialogClose id="cancelReportButton" type="button" variant="outline">Cancelar</DialogClose>
								<DialogClose id="reportCloseButton" type="button" class="hidden">Fechar</DialogClose>
								<Button type="submit" class="bg-emerald-500 font-bold text-emerald-950 hover:bg-emerald-400">
									<Send class="size-4" /> Enviar
								</Button>
							</DialogFooter>
						</form>
					</DialogContent>
				</Dialog>
			</div>
		</aside>

		<div class="toast fixed bottom-5 left-1/2 z-50 -translate-x-1/2 translate-y-4 rounded-full border border-emerald-500/15 bg-[#0a1f1a]/95 px-5 py-2.5 text-sm font-bold opacity-0 shadow-lg backdrop-blur transition" id="toast" role="status" aria-live="polite"></div>

		<script>
			const canvas = document.querySelector<HTMLCanvasElement>('#gameCanvas')!;
			const ctx = canvas.getContext('2d')!;
			const nextCanvas = document.querySelector<HTMLCanvasElement>('#nextCanvas')!;
			const nextCtx = nextCanvas.getContext('2d')!;
			const highScoreEl = document.querySelector<HTMLElement>('#highScore')!;
			const overlay = document.querySelector<HTMLElement>('#gameOverlay')!;
			const startButton = document.querySelector<HTMLElement>('#startButton')!;
			const pauseButton = document.querySelector<HTMLElement>('#pauseButton')!;
			const settingsButton = document.querySelector<HTMLElement>('#settingsButton')!;
			const closeSettingsButton = document.querySelector<HTMLElement>('#closeSettingsButton')!;
			const settingsPanel = document.querySelector<HTMLElement>('#settingsPanel')!;
			const reportButton = document.querySelector<HTMLElement>('#reportButton')!;
			const reportCloseButton = document.querySelector<HTMLElement>('#reportCloseButton')!;
			const reportForm = document.querySelector<HTMLFormElement>('#reportForm')!;
			const reportMessage = document.querySelector<HTMLTextAreaElement>('#reportMessage')!;
			const toast = document.querySelector<HTMLElement>('#toast')!;

			const COLS = 10;
			const ROWS = 20;
			const BLOCK = 24;
			const BG = '#071f1a';

			const COLORS = [
				'#000000',
				'#2dd4bf',
				'#60a5fa',
				'#f97316',
				'#facc15',
				'#4ade80',
				'#c084fc',
				'#fb7185',
			];

			const PIECES = [
				[[1, 1, 1, 1]],
				[[2, 0, 0], [2, 2, 2]],
				[[0, 0, 3], [3, 3, 3]],
				[[4, 4], [4, 4]],
				[[0, 5, 5], [5, 5, 0]],
				[[0, 6, 0], [6, 6, 6]],
				[[7, 7, 0], [0, 7, 7]],
			];

			let arena = createArena();
			let player = { matrix: null as number[][] | null, x: 0, y: 0 };
			let nextPiece: number[][] | null = null;
			let score = 0;
			let linesCount = 0;
			let level = 1;
			let highScore = 0;
			let dropCounter = 0;
			let lastTime = 0;
			let running = false;
			let paused = false;

			try { highScore = parseInt(localStorage.getItem('blocos-high') || '0', 10); } catch {}
			highScoreEl.textContent = String(highScore);

			ctx.scale(BLOCK, BLOCK);
			nextCtx.scale(BLOCK, BLOCK);

			function createArena(): number[][] {
				return Array.from({ length: ROWS }, () => Array(COLS).fill(0));
			}

			function createPiece(): number[][] {
				return PIECES[Math.floor(Math.random() * PIECES.length)].map(r => [...r]);
			}

			function drawCell(c: CanvasRenderingContext2D, x: number, y: number, value: number) {
				c.fillStyle = COLORS[value];
				c.fillRect(x, y, 1, 1);

				c.fillStyle = 'rgba(255,255,255,0.28)';
				c.fillRect(x + 0.04, y + 0.04, 0.92, 0.06);
				c.fillRect(x + 0.04, y + 0.04, 0.06, 0.92);

				c.fillStyle = 'rgba(0,0,0,0.28)';
				c.fillRect(x + 0.04, y + 0.90, 0.92, 0.06);
				c.fillRect(x + 0.90, y + 0.04, 0.06, 0.92);

				c.fillStyle = 'rgba(255,255,255,0.06)';
				c.fillRect(x + 0.14, y + 0.14, 0.72, 0.32);
			}

			function drawMatrix(c: CanvasRenderingContext2D, matrix: number[][], offset: { x: number; y: number }) {
				matrix.forEach((row, y) => {
					row.forEach((value, x) => {
						if (value) drawCell(c, x + offset.x, y + offset.y, value);
					});
				});
			}

			function getGhostY(): number {
				if (!player.matrix) return player.y;
				let testY = player.y;
				while (true) {
					testY++;
					for (let y = 0; y < player.matrix.length; y++) {
						for (let x = 0; x < player.matrix[y].length; x++) {
							if (player.matrix[y][x]) {
								const bx = x + player.x;
								const by = y + testY;
								if (by >= ROWS || bx < 0 || bx >= COLS || (by >= 0 && arena[by][bx] !== 0)) {
									return testY - 1;
								}
							}
						}
					}
				}
			}

			function drawGhost() {
				if (!player.matrix) return;
				const ghostY = getGhostY();
				if (ghostY <= player.y) return;
				ctx.globalAlpha = 0.15;
				player.matrix.forEach((row, y) => {
					row.forEach((value, x) => {
						if (value) {
							ctx.fillStyle = COLORS[value];
							ctx.fillRect(x + player.x, y + ghostY, 1, 1);
							ctx.strokeStyle = 'rgba(255,255,255,0.1)';
							ctx.lineWidth = 0.04;
							ctx.strokeRect(x + player.x + 0.04, y + ghostY + 0.04, 0.92, 0.92);
						}
					});
				});
				ctx.globalAlpha = 1;
			}

			function drawNext() {
				nextCtx.fillStyle = BG;
				nextCtx.fillRect(0, 0, 4, 4);
				if (!nextPiece) return;
				const ox = (4 - nextPiece[0].length) / 2;
				const oy = (4 - nextPiece.length) / 2;
				drawMatrix(nextCtx, nextPiece, { x: ox, y: oy });
			}

			function draw() {
				ctx.fillStyle = BG;
				ctx.fillRect(0, 0, COLS, ROWS);

				ctx.strokeStyle = 'rgba(16,185,129,0.04)';
				ctx.lineWidth = 0.02;
				for (let x = 0; x <= COLS; x++) {
					ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, ROWS); ctx.stroke();
				}
				for (let y = 0; y <= ROWS; y++) {
					ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(COLS, y); ctx.stroke();
				}

				drawMatrix(ctx, arena, { x: 0, y: 0 });
				if (player.matrix && running && !paused) drawGhost();
				if (player.matrix) drawMatrix(ctx, player.matrix, player);
			}

			function collide(): boolean {
				if (!player.matrix) return false;
				for (let y = 0; y < player.matrix.length; y++) {
					for (let x = 0; x < player.matrix[y].length; x++) {
						if (player.matrix[y][x] && (arena[y + player.y]?.[x + player.x] !== 0)) return true;
					}
				}
				return false;
			}

			function merge() {
				player.matrix?.forEach((row, y) => {
					row.forEach((value, x) => {
						if (value) arena[y + player.y][x + player.x] = value;
					});
				});
			}

			function sweep() {
				let cleared = 0;
				outer: for (let y = arena.length - 1; y >= 0; y--) {
					for (let x = 0; x < arena[y].length; x++) {
						if (!arena[y][x]) continue outer;
					}
					arena.splice(y, 1);
					arena.unshift(Array(COLS).fill(0));
					cleared++;
					y++;
				}
				if (cleared) {
					linesCount += cleared;
					score += [0, 100, 300, 500, 800][cleared] * level;
					level = Math.floor(linesCount / 8) + 1;
					updateHud();
				}
			}

			function rotate(matrix: number[][]) {
				for (let y = 0; y < matrix.length; y++) {
					for (let x = 0; x < y; x++) {
						[matrix[x][y], matrix[y][x]] = [matrix[y][x], matrix[x][y]];
					}
				}
				matrix.forEach(r => r.reverse());
			}

			function playerRotate() {
				if (!running || paused || !player.matrix) return;
				const startX = player.x;
				let offset = 1;
				rotate(player.matrix);
				while (collide()) {
					player.x += offset;
					offset = -(offset + (offset > 0 ? 1 : -1));
					if (offset > player.matrix[0].length) {
						rotate(player.matrix); rotate(player.matrix); rotate(player.matrix);
						player.x = startX;
						return;
					}
				}
				draw();
			}

			function playerMove(dir: number) {
				if (!running || paused) return;
				player.x += dir;
				if (collide()) player.x -= dir;
				draw();
			}

			function playerDrop() {
				if (!running || paused) return;
				player.y++;
				if (collide()) {
					player.y--;
					merge();
					sweep();
					playerReset();
				}
				dropCounter = 0;
				draw();
			}

			function hardDrop() {
				if (!running || paused || !player.matrix) return;
				const ghostY = getGhostY();
				score += (ghostY - player.y) * 2;
				player.y = ghostY;
				merge();
				sweep();
				playerReset();
				dropCounter = 0;
				updateHud();
				draw();
			}

			function playerReset() {
				player.matrix = nextPiece || createPiece();
				nextPiece = createPiece();
				drawNext();
				player.y = 0;
				player.x = Math.floor((COLS - player.matrix[0].length) / 2);
				if (collide()) {
					running = false;
					const isNewRecord = score > highScore && score > 0;
					if (isNewRecord) {
						highScore = score;
						try { localStorage.setItem('blocos-high', String(highScore)); } catch {}
						highScoreEl.textContent = String(highScore);
					}
					overlay.classList.add('show');
					overlay.innerHTML = `
						<strong class="text-xl font-bold sm:text-2xl">Fim de jogo</strong>
						<span class="tabular-nums text-base text-emerald-300/60">${score} pontos</span>
						${isNewRecord ? '<span class="text-xs font-semibold text-amber-400">Novo recorde!</span>' : ''}
						<span class="mt-1 text-xs text-emerald-400/30">Toque em iniciar</span>
					`;
				}
			}

			function updateStat(name: string, value: number) {
				document.querySelectorAll<HTMLElement>(`[data-stat="${name}"]`).forEach(el => {
					el.textContent = String(value);
					el.classList.remove('bump');
					void el.offsetWidth;
					el.classList.add('bump');
				});
			}

			function updateHud() {
				updateStat('score', score);
				updateStat('lines', linesCount);
				updateStat('level', level);
			}

			function update(time = 0) {
				const delta = time - lastTime;
				lastTime = time;
				if (running && !paused) {
					dropCounter += delta;
					if (dropCounter > Math.max(100, 800 - level * 60)) playerDrop();
				}
				draw();
				requestAnimationFrame(update);
			}

			function setPauseLabel(label: string) {
				const icon = label === 'Continuar'
					? '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="6 3 20 12 6 21 6 3"/></svg>'
					: '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="14" y="4" width="4" height="16" rx="1"/><rect x="6" y="4" width="4" height="16" rx="1"/></svg>';
				pauseButton.innerHTML = `${icon} <span class="btn-label">${label}</span>`;
			}

			function startGame() {
				arena = createArena();
				score = 0;
				linesCount = 0;
				level = 1;
				dropCounter = 0;
				running = true;
				paused = false;
				nextPiece = null;
				setPauseLabel('Pausar');
				overlay.classList.remove('show');
				updateHud();
				playerReset();
				draw();
			}

			function togglePause() {
				if (!running) return;
				paused = !paused;
				setPauseLabel(paused ? 'Continuar' : 'Pausar');
				overlay.classList.toggle('show', paused);
				if (paused) overlay.innerHTML = '<strong class="text-lg font-bold">Pausado</strong><span class="text-xs text-emerald-300/50">Toque em continuar</span>';
			}

			function showToast(msg: string) {
				toast.textContent = msg;
				toast.classList.add('show');
				setTimeout(() => toast.classList.remove('show'), 2600);
			}

			function setSettings(open: boolean) {
				settingsPanel.classList.toggle('open', open);
				settingsPanel.setAttribute('aria-hidden', String(!open));
			}

			function getCurrentPosition(): Promise<GeolocationPosition> {
				return new Promise((resolve, reject) => {
					if (!('geolocation' in navigator)) {
						reject(new Error('Geolocalização indisponível.'));
						return;
					}
					navigator.geolocation.getCurrentPosition(resolve, reject, {
						enableHighAccuracy: true,
						timeout: 12000,
						maximumAge: 0,
					});
				});
			}

			startButton.addEventListener('click', startGame);
			pauseButton.addEventListener('click', togglePause);

			document.querySelectorAll<HTMLElement>('[data-action]').forEach(btn => {
				btn.addEventListener('click', () => {
					const a = btn.dataset.action;
					if (a === 'left') playerMove(-1);
					if (a === 'right') playerMove(1);
					if (a === 'down') playerDrop();
					if (a === 'rotate') playerRotate();
					if (a === 'hardDrop') hardDrop();
				});
			});

			document.addEventListener('keydown', (e) => {
				if (['ArrowLeft', 'ArrowRight', 'ArrowDown', 'ArrowUp', ' '].includes(e.key)) e.preventDefault();
				if (e.key === 'ArrowLeft') playerMove(-1);
				if (e.key === 'ArrowRight') playerMove(1);
				if (e.key === 'ArrowDown') playerDrop();
				if (e.key === 'ArrowUp') playerRotate();
				if (e.key === ' ') hardDrop();
				if (e.key.toLowerCase() === 'p') togglePause();
			});

			settingsButton.addEventListener('click', () => setSettings(true));
			closeSettingsButton.addEventListener('click', () => setSettings(false));
			settingsPanel.addEventListener('click', (e) => { if (e.target === settingsPanel) setSettings(false); });
			reportButton.addEventListener('click', () => setSettings(false));

			reportForm.addEventListener('submit', async (e) => {
				e.preventDefault();
				const message = reportMessage.value.trim();
				if (!message) return;
				try {
					const position = await getCurrentPosition();
					const { latitude, longitude, accuracy } = position.coords;
					console.info('[game-report]', {
						message, timestamp: new Date().toISOString(),
						location: { latitude, longitude, accuracy, mapsUrl: `https://maps.google.com/?q=${latitude},${longitude}` },
					});
					showToast('Relatório enviado. Obrigado!');
				} catch (error) {
					console.info('[game-report]', {
						message, timestamp: new Date().toISOString(),
						locationError: error instanceof Error ? error.message : String(error),
					});
					showToast('Relatório enviado sem localização.');
				} finally {
					reportForm.reset();
					reportCloseButton.click();
				}
			});

			draw();
			drawNext();
			requestAnimationFrame(update);
		</script>
	</body>
</html>

<style>
	:global(button), .ctrl-btn, .board-canvas {
		touch-action: manipulation;
	}

	.game-bg {
		background:
			radial-gradient(ellipse 500px 350px at 25% 8%, rgba(16, 185, 129, 0.07) 0%, transparent 100%),
			radial-gradient(ellipse 400px 300px at 80% 92%, rgba(16, 185, 129, 0.05) 0%, transparent 100%),
			#0a1f1a;
	}

	.game-wrapper {
		padding-bottom: max(0, env(safe-area-inset-bottom));
		width: 100%;
